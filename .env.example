## .env.example
```env
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Search
SERPAPI_API_KEY=

# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-research-agent
LANGSMITH_TRACING=true

# General
LOG_LEVEL=INFO
SQLITE_PATH=/data/agent.sqlite3
SIM_THRESHOLD=0.9
MAX_RESULTS=6
TIMEOUT_S=30